{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Auto-merge non-major GitHub Actions updates (SHA-pinned)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true
    },
    {
      "description": "Never auto-merge this repository's own Action pin (RELEASING.md pins it by hand)",
      "matchPackageNames": ["jschuller/mcp-server-servicenow"],
      "automerge": false
    },
    {
      "description": "Python dependency updates are reviewed PRs (RELEASING.md triage protocol): main is also the plugin marketplace",
      "matchManagers": ["pep621"],
      "automerge": false
    }
  ],
  "platformAutomerge": true
}
