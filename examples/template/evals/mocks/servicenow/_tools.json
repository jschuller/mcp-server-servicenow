{
  "tools": [
    {
      "name": "aggregate_records",
      "title": "Aggregate Records",
      "description": "Aggregate records using COUNT, AVG, MIN, MAX, SUM with optional GROUP BY via the Stats API",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "table_name": {
            "description": "The ServiceNow table name (e.g., 'sys_user_group', 'cmdb_ci', 'incident')",
            "type": "string"
          },
          "count": {
            "default": true,
            "description": "Include record count in results",
            "type": "boolean"
          },
          "avg_fields": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Comma-separated fields to average (e.g., 'reassignment_count,reopen_count')"
          },
          "min_fields": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Comma-separated fields to find minimum values"
          },
          "max_fields": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Comma-separated fields to find maximum values"
          },
          "sum_fields": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Comma-separated fields to sum"
          },
          "group_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Comma-separated fields to group results by (e.g., 'priority,state')"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Encoded query string to filter records before aggregation"
          },
          "having": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Post-aggregation filter (e.g., 'COUNT>5')"
          }
        },
        "required": [
          "table_name"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": [
            "read",
            "table"
          ]
        }
      }
