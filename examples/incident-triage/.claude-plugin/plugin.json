{
  "name": "servicenow-incident-triage",
  "version": "0.1.0",
  "description": "Example skill for mcp-server-servicenow: incident triage and trend reports (ITSM, itil).",
  "license": "MIT",
  "skills": "./skills/",
  "mcpServers": {
    "servicenow": {
      "command": "uvx",
      "args": ["mcp-server-servicenow==0.9.3"],
      "env": {
        "SERVICENOW_INSTANCE_URL": "${SERVICENOW_INSTANCE_URL}",
        "SERVICENOW_USERNAME": "${SERVICENOW_USERNAME:-}",
        "SERVICENOW_PASSWORD": "${SERVICENOW_PASSWORD:-}"
      }
    }
  }
}
