      "name": "find_references",
      "title": "Find References",
      "description": "Where-used for a table or one of its fields: the business rules, client scripts, UI policies, ACLs, script includes and reference fields that touch it.\n\nReturns names, sys_ids and flags only, never script, condition or ACL\nbodies. Script matches (script includes; business rules and client scripts\nin field mode) are text matches, so expect false positives. Only this exact\ntable is matched: run it again for a parent table (get_table_schema's\nhierarchy) to find rules and ACLs defined there. A source this identity\ncan't read (403, or a 401 from an access policy that leaves its table out)\nis listed in not_assessable (under OAuth each such source costs one token\nrefresh). Under basic auth the first 401 is an error (a refused password\nlooks the same), and so is a refused OAuth secret; rows hidden by an ACL\nare simply missing. complete=false means the source hit the limit.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table_name": {
            "description": "The table to look up (e.g., 'incident')",
            "maxLength": 80,
            "type": "string"
          },
          "field_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Narrow to one field of the table (e.g., 'assigned_to')"
          },
          "limit": {
            "default": 50,
            "description": "Maximum matches to return per source",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "table_name"
        ]
      },
      "outputSchema": {
        "properties": {
          "table": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "groups": {
            "items": {
              "properties": {
                "source": {
                  "type": "string"
                },
                "table": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "complete": {
                  "type": "boolean"
                },
                "items": {
